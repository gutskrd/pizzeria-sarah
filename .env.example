# ─────────────────────────────────────────────────────────────
# Pizzeria Sarah — omgevingsvariabelen
# Kopieer dit bestand naar `.env` en vul de waarden in.
# Zet NOOIT echte geheimen in Git.
# ─────────────────────────────────────────────────────────────

# Publieke adres van de website (zonder slash aan het eind).
SITE_URL=https://pizzaria-sarah.nl

# PostgreSQL-verbinding.
DATABASE_URL=postgres://sarah:CHANGE_ME@db:5432/pizzeria_sarah
# Alleen voor docker-compose: wachtwoord van de database-container.
POSTGRES_PASSWORD=CHANGE_ME

# Geheime sleutel (minimaal 32 tekens) voor het hashen van verificatiecodes
# en het ondertekenen van formulier-tokens. Genereer met:
#   openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Map waarin geüploade foto's worden opgeslagen.
MEDIA_DIR=./data/media

# E-mail via Resend (https://resend.com). De API-sleutel blijft op de server.
RESEND_API_KEY=
# Afzender; het domein moet bij Resend geverifieerd zijn.
EMAIL_FROM="Pizzeria Sarah <website@pizzaria-sarah.nl>"
# Ontwikkeling: schrijf e-mails naar ./data/outbox in plaats van ze te versturen.
# Wordt genegeerd als NODE_ENV=production.
EMAIL_DEV_OUTBOX=1

# Cloudflare Turnstile (optioneel, maar aanbevolen voor het contactformulier).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zet op 1 als de site achter Cloudflare draait. Dan worden de headers
# CF-Connecting-IP en CF-IPCountry (en eventueel cf-ipcity/cf-region)
# vertrouwd voor IP-adres en globale locatie van ingelogde apparaten.
TRUST_CLOUDFLARE_HEADERS=0
# Zet op 1 als er een reverse proxy (zoals Caddy) vóór de app staat die
# X-Forwarded-For betrouwbaar invult.
TRUST_PROXY_HEADERS=1
